<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="s_face" fileName="game/player_cosmetics4.rttex" textureSize="32" frame="10,13"/>

    <StateMachines>
      <StateMachine name="Zombie">
        <States start="Off">
          <State name="On" />
          <State name="Off" />
        </States>
        <Transitions>
          <Transition to="Off" from="On">
            <Condition>
              <IsZombified>false</IsZombified>
            </Condition>
          </Transition>
          <Transition to="On" from="Off">
            <Condition>
              <IsZombified>true</IsZombified>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>
	</Data>
	<RenderRules>
		<RenderFaceItem>
			<ContextUpdate type="SetTint"  onState="Zombie.On">
				<Set name="forceTint">true</Set>
				<Set name="tint">255,255,255,255</Set>
			</ContextUpdate>
			<SpriteRender name="s_face" blend="PREMULTIPLIED_ALPHA" alignment="DOWN_CENTER" drawShadow="false"/>
		</RenderFaceItem>
	</RenderRules>
</ItemRenderer>
